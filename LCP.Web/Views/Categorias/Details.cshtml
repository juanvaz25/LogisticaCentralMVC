@model LCP.Web.Models.Entities.Categoria
@{
    ViewData["Title"] = $"Detalle Categoría - {Model.Nombre}";
}

<div class="container px-lg-5 py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card card-lcp border-0 shadow-sm p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                    <div>
                        <h3 class="fw-bold text-dark mb-1">Detalle de Categoría</h3>
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary rounded-pill btn-sm px-3">
                            <i class="fas fa-edit me-1"></i> Editar
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm">Volver</a>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3 mb-4 p-3 bg-light rounded-3">
                    <div class="bg-primary text-white p-3 rounded-circle fs-4">
                        <i class="@(Model.Icono ?? "fas fa-box")"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-dark mb-1">@Model.Nombre</h4>
                        <span class="badge @(Model.Activo ? "bg-success" : "bg-danger")">@(Model.Activo ? "Activa" : "Inactiva")</span>
                        <span class="badge bg-light text-dark border ms-1">@(Model.Productos?.Count ?? 0) publicaciones</span>
                    </div>
                </div>

                <div class="mb-3">
                    <h6 class="fw-bold text-muted small text-uppercase">Descripción:</h6>
                    <p class="text-secondary">@(Model.Descripcion ?? "Sin descripción.")</p>
                </div>

                <div class="small text-muted border-top pt-3">
                    <i class="far fa-calendar-alt me-1"></i> Fecha de creación: @Model.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm") hs
                </div>
            </div>
        </div>
    </div>
</div>
