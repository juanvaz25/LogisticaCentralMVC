@model LCP.Web.Models.Entities.Categoria
@{
    ViewData["Title"] = "Crear Categoría";
}

<div class="container px-lg-5 py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card card-lcp border-0 shadow-sm p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                    <div>
                        <h3 class="fw-bold text-dark mb-1"><i class="fas fa-tags text-primary me-2"></i>Nueva Categoría</h3>
                        <p class="text-muted small mb-0">Agregar un nuevo rubro o categoría de productos</p>
                    </div>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm">Volver</a>
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold small text-dark"></label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ej: Alimentos y Bebidas Regionales" autofocus />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Icono" class="form-label fw-semibold small text-dark"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fas fa-icons"></i></span>
                            <input asp-for="Icono" class="form-control" placeholder="fas fa-utensils, fas fa-tools, etc." />
                        </div>
                        <small class="text-muted">Clases de icono FontAwesome (ej: fas fa-box, fas fa-seedling)</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label fw-semibold small text-dark"></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Descripción breve del rubro..."></textarea>
                    </div>

                    <div class="mb-4 form-check form-switch p-3 bg-light rounded-3 border">
                        <input asp-for="Activo" class="form-check-input ms-0 me-2" checked />
                        <label asp-for="Activo" class="form-check-label fw-semibold text-dark"></label>
                    </div>

                    <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm">
                        <i class="fas fa-save me-1"></i> Guardar Categoría
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
