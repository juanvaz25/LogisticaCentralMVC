@model List<LCP.Web.Models.Entities.Categoria>
@{
    ViewData["Title"] = "Gestión de Categorías";
}

<div class="container-fluid px-lg-5 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h1 class="fw-bold text-dark mb-1"><i class="fas fa-tags text-primary me-2"></i>Categorías y Rubros</h1>
            <p class="text-muted small mb-0">Administración de categorías del catálogo de Logística Centro País</p>
        </div>
        <a asp-action="Create" class="btn btn-success rounded-pill btn-sm px-3 shadow-sm">
            <i class="fas fa-plus-circle me-1"></i> Nueva Categoría
        </a>
    </div>

    <div class="card card-lcp border-0 shadow-sm p-4">
        <div class="table-responsive">
            <table class="table table-hover table-lcp align-middle datatable-lcp mb-0">
                <thead>
                    <tr>
                        <th style="width: 50px;">Icono</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th class="text-center">Productos</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="text-center text-primary fs-5">
                                <i class="@(c.Icono ?? "fas fa-box")"></i>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@c.Nombre</div>
                                <small class="text-muted">Creada: @c.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy")</small>
                            </td>
                            <td>
                                <small class="text-secondary text-truncate-2" style="max-width: 320px;">@c.Descripcion</small>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-primary border fw-bold">@(c.Productos?.Count ?? 0) u.</span>
                            </td>
                            <td>
                                <span class="badge @(c.Activo ? "bg-success" : "bg-secondary")">
                                    @(c.Activo ? "Activa" : "Inactiva")
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary rounded-pill px-2 me-1" title="Editar">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-2 me-1" title="Detalle">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2" onclick="eliminarCategoria(@c.Id, '@c.Nombre')" title="Desactivar">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function eliminarCategoria(id, nombre) {
            Swal.fire({
                title: '¿Desactivar categoría?',
                text: `¿Seguro que deseas desactivar la categoría "${nombre}"?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, desactivar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Categorias/Delete/' + id,
                        type: 'POST',
                        data: {
                            "__RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (res) {
                            if (res.success) {
                                Swal.fire('¡Listo!', res.message, 'success').then(() => location.reload());
                            } else {
                                Swal.fire('Atención', res.message, 'warning');
                            }
                        }
                    });
                }
            });
        }
    </script>
}
