@{
    ViewData["Title"] = "Acceso Restringido";
}

<div class="container px-lg-5 py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card card-lcp border-0 shadow-sm p-5">
                <div class="text-danger mb-3">
                    <i class="fas fa-ban fa-4x"></i>
                </div>
                <h2 class="fw-bold text-dark mb-2">Acceso No Autorizado</h2>
                <p class="text-muted mb-4">No tenés los permisos o el rol necesario para ingresar a esta sección del sistema LCP.</p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                        <i class="fas fa-home me-1"></i> Ir al Inicio
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary rounded-pill px-4">
                        Cambiar de Cuenta
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
