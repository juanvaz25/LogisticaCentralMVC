@model LCP.Web.Models.ViewModels.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "Cambiar Contraseña";
}

<div class="container px-lg-5 py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card card-lcp border-0 shadow-sm p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle d-inline-flex mb-2">
                        <i class="fas fa-key fa-2x"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">Cambiar Contraseña</h3>
                    <p class="text-muted small">Actualizá tu clave de acceso por seguridad</p>
                </div>

                <form asp-controller="Account" asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-semibold small text-dark"></label>
                        <input asp-for="CurrentPassword" class="form-control" />
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold small text-dark"></label>
                        <input asp-for="NewPassword" class="form-control" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmNewPassword" class="form-label fw-semibold small text-dark"></label>
                        <input asp-for="ConfirmNewPassword" class="form-control" />
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold rounded-pill shadow-sm mb-2">
                        <i class="fas fa-check me-1"></i> Actualizar Contraseña
                    </button>
                    <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary w-100 rounded-pill">
                        Cancelar
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
