@model LCP.Web.Models.ViewModels.Account.ProfileViewModel
@{
    ViewData["Title"] = "Mi Perfil de Usuario";
}

<div class="container px-lg-5 py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card card-lcp border-0 shadow-sm p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                    <div>
                        <span class="badge bg-primary rounded-pill px-3 py-1 mb-1">Rol: @Model.Rol</span>
                        <h3 class="fw-bold text-dark mb-0">Mi Perfil</h3>
                    </div>
                    <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline-secondary rounded-pill btn-sm">
                        <i class="fas fa-key me-1"></i> Cambiar Contraseña
                    </a>
                </div>

                <form asp-controller="Account" asp-action="Profile" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Rol" />
                    <input type="hidden" asp-for="FotoPerfilUrl" />

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <!-- Foto de perfil -->
                    <div class="d-flex align-items-center gap-3 mb-4 p-3 bg-light rounded-3">
                        @if (!string.IsNullOrEmpty(Model.FotoPerfilUrl))
                        {
                            <img src="@Model.FotoPerfilUrl" alt="Foto Perfil" class="rounded-circle shadow-sm" width="70" height="70" style="object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 70px; height: 70px; font-size: 1.8rem;">
                                <i class="fas fa-user"></i>
                            </div>
                        }
                        <div class="flex-grow-1">
                            <label asp-for="NuevaFoto" class="form-label fw-semibold small text-dark mb-1"></label>
                            <input asp-for="NuevaFoto" type="file" class="form-control form-control-sm" accept=".jpg,.jpeg,.png,.webp" />
                            <small class="text-muted" style="font-size: 0.75rem;">Formatos aceptados: JPG, PNG, WEBP (Máx 2MB)</small>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Nombre" class="form-label fw-semibold small text-dark"></label>
                            <input asp-for="Nombre" class="form-control" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Apellido" class="form-label fw-semibold small text-dark"></label>
                            <input asp-for="Apellido" class="form-control" />
                            <span asp-validation-for="Apellido" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Correo Electrónico</label>
                            <input value="@Model.Email" class="form-control bg-light" disabled />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold small text-dark"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Dni" class="form-label fw-semibold small text-dark"></label>
                            <input asp-for="Dni" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Ciudad" class="form-label fw-semibold small text-dark"></label>
                            <input asp-for="Ciudad" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Provincia" class="form-label fw-semibold small text-dark"></label>
                            <input asp-for="Provincia" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Direccion" class="form-label fw-semibold small text-dark"></label>
                        <input asp-for="Direccion" class="form-control" />
                    </div>

                    @if (Model.Rol == "Vendedor" || Model.Rol == "Administrador")
                    {
                        <div class="p-3 bg-light rounded-3 mb-4 border">
                            <h6 class="fw-bold text-primary mb-3"><i class="fas fa-store me-2"></i>Datos Comerciales</h6>
                            <div class="row g-3">
                                <div class="col-md-7">
                                    <label asp-for="NombreComercio" class="form-label fw-semibold small text-dark"></label>
                                    <input asp-for="NombreComercio" class="form-control" />
                                </div>
                                <div class="col-md-5">
                                    <label asp-for="Cuit" class="form-label fw-semibold small text-dark"></label>
                                    <input asp-for="Cuit" class="form-control" />
                                </div>
                            </div>
                        </div>
                    }

                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                        <i class="fas fa-save me-1"></i> Guardar Cambios
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
