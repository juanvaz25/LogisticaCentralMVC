@model LCP.Web.Models.ViewModels.Consultas.ConsultaResponderViewModel
@{
    ViewData["Title"] = $"Consulta: {Model.Consulta?.Asunto}";
    var c = Model.Consulta;
}

<div class="container px-lg-5 py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card card-lcp border-0 shadow-sm p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                    <div>
                        <span class="badge @(c?.Respondido == true ? "bg-success" : "bg-warning text-dark") rounded-pill mb-1">
                            @(c?.Respondido == true ? "Respondida" : "Pendiente de respuesta")
                        </span>
                        <h3 class="fw-bold text-dark mb-0">@c?.Asunto</h3>
                    </div>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm">Volver</a>
                </div>

                @if (c?.Producto != null)
                {
                    <div class="p-3 bg-light rounded-3 mb-4 border d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted d-block text-uppercase fw-bold">Referente a la publicación:</small>
                            <strong class="text-dark">@c.Producto.Nombre</strong>
                            <span class="text-primary fw-bold ms-2">$@c.Producto.Precio.ToString("N2")</span>
                        </div>
                        <a asp-controller="Catalogo" asp-action="Detalle" asp-route-id="@c.Producto.Id" class="btn btn-sm btn-outline-primary rounded-pill">Ver Producto</a>
                    </div>
                }

                <!-- Mensaje Original -->
                <div class="p-4 bg-light rounded-4 mb-4 border">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold text-dark"><i class="fas fa-user-circle text-primary me-1"></i>@(c?.Emisor?.NombreCompleto)</span>
                        <small class="text-muted"><i class="far fa-clock me-1"></i>@c?.FechaEnvio.ToLocalTime().ToString("dd/MM/yyyy HH:mm") hs</small>
                    </div>
                    <p class="text-secondary mb-0" style="white-space: pre-line;">@c?.Mensaje</p>
                </div>

                <!-- Respuesta si ya existe -->
                @if (c?.Respondido == true && !string.IsNullOrEmpty(c.Respuesta))
                {
                    <div class="p-4 bg-primary bg-opacity-10 border border-primary border-opacity-25 rounded-4 mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-primary"><i class="fas fa-reply-all me-1"></i>Respuesta oficial de @(c.Receptor != null ? (c.Receptor.NombreComercio ?? c.Receptor.NombreCompleto) : "Soporte Central LCP")</span>
                            <small class="text-muted"><i class="far fa-clock me-1"></i>@(c.FechaRespuesta?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")) hs</small>
                        </div>
                        <p class="text-dark mb-0" style="white-space: pre-line;">@c.Respuesta</p>
                    </div>
                }

                <!-- Formulario de Respuesta (Si no fue respondida aún o para actualizar) -->
                @if (c?.Respondido != true)
                {
                    <div class="card p-4 border rounded-4 bg-white">
                        <h5 class="fw-bold text-dark mb-3"><i class="fas fa-edit text-primary me-2"></i>Escribir Respuesta</h5>
                        <form asp-action="Responder" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="ConsultaId" />

                            <div class="mb-3">
                                <textarea asp-for="Respuesta" class="form-control" rows="4" placeholder="Escribí una respuesta clara y profesional..."></textarea>
                                <span asp-validation-for="Respuesta" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm">
                                <i class="fas fa-reply me-1"></i> Enviar Respuesta
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
