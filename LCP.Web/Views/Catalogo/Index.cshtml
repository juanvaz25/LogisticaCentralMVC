@model LCP.Web.Models.ViewModels.Productos.CatalogoFiltroViewModel
@{
    ViewData["Title"] = "Catálogo de Productos";
}

<div class="container-fluid px-lg-5 py-4">
    <!-- Header del Catálogo -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h1 class="fw-bold text-dark mb-1"><i class="fas fa-boxes text-primary me-2"></i>Catálogo de Publicaciones</h1>
            <p class="text-muted small mb-0">Mostrando @Model.TotalElementos productos disponibles en la red de distribución</p>
        </div>
        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
            <span class="small text-muted">Ordenar:</span>
            <select class="form-select form-select-sm rounded-pill" onchange="cambiarOrden(this.value)" style="width: 180px;">
                <option value="recientes" selected="@(Model.OrdenarPor == "recientes" || string.IsNullOrEmpty(Model.OrdenarPor))">Más recientes</option>
                <option value="precio_asc" selected="@(Model.OrdenarPor == "precio_asc")">Menor precio</option>
                <option value="precio_desc" selected="@(Model.OrdenarPor == "precio_desc")">Mayor precio</option>
                <option value="nombre" selected="@(Model.OrdenarPor == "nombre")">Alfabético</option>
            </select>
        </div>
    </div>

    <div class="row g-4">
        <!-- Sidebar Filtros -->
        <div class="col-lg-3">
            <div class="card card-lcp border-0 shadow-sm p-4 sticky-top" style="top: 90px; z-index: 10;">
                <h5 class="fw-bold text-dark mb-3"><i class="fas fa-filter text-primary me-2"></i>Filtros</h5>

                <form id="form-filtros" asp-controller="Catalogo" asp-action="Index" method="get">
                    <input type="hidden" name="OrdenarPor" value="@Model.OrdenarPor" />
                    <input type="hidden" name="Pagina" value="1" />

                    <!-- Búsqueda Sensitiva -->
                    <div class="mb-3 position-relative">
                        <label class="form-label fw-semibold small text-dark">Búsqueda rápida</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted"></i></span>
                            <input type="text" id="catalogo-live-input" name="Busqueda" value="@Model.Busqueda" class="form-control border-start-0" placeholder="Nombre, código SKU..." autocomplete="off" />
                        </div>
                        <!-- Dropdown de resultados en vivo -->
                        <div id="catalogo-live-results" class="live-search-results d-none"></div>
                    </div>

                    <!-- Categorías -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Categoría</label>
                        <select name="CategoriaId" class="form-select" onchange="$('#form-filtros').submit();">
                            <option value="">Todas las categorías</option>
                            @foreach (var c in Model.Categorias)
                            {
                                <option value="@c.Id" selected="@(Model.CategoriaId == c.Id)">@c.Nombre (@(c.Productos?.Count ?? 0))</option>
                            }
                        </select>
                    </div>

                    <!-- Rango de Precios -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold small text-dark">Rango de Precio ($)</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="number" name="PrecioMin" value="@Model.PrecioMin" class="form-control form-control-sm" placeholder="Mínimo" />
                            </div>
                            <div class="col-6">
                                <input type="number" name="PrecioMax" value="@Model.PrecioMax" class="form-control form-control-sm" placeholder="Máximo" />
                            </div>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary rounded-pill fw-semibold shadow-sm">
                            <i class="fas fa-search me-1"></i> Aplicar Filtros
                        </button>
                        <a asp-controller="Catalogo" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">
                            Limpiar Filtros
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Grid de Productos -->
        <div class="col-lg-9">
            @if (Model.Productos.Any())
            {
                <div class="row g-4">
                    @foreach (var prod in Model.Productos)
                    {
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="product-card">
                                <div class="product-img-wrapper">
                                    <img src="@(prod.ImagenUrl ?? "/images/no-image.png")" alt="@prod.Nombre" loading="lazy" />
                                    <span class="badge bg-primary position-absolute top-0 start-0 m-2 rounded-pill px-2 py-1 small">
                                        @(prod.Categoria?.Nombre ?? "General")
                                    </span>
                                    @if (prod.Stock <= 0)
                                    {
                                        <span class="badge bg-danger position-absolute top-0 end-0 m-2 rounded-pill px-2 py-1 small">
                                            Sin Stock
                                        </span>
                                    }
                                </div>
                                <div class="p-3 d-flex flex-column flex-grow-1">
                                    <div class="text-muted small mb-1">
                                        <i class="fas fa-store me-1"></i>@(prod.Vendedor?.NombreComercio ?? prod.Vendedor?.NombreCompleto)
                                    </div>
                                    <h6 class="fw-bold text-dark text-truncate-2 mb-2" style="min-height: 42px;">
                                        <a asp-controller="Catalogo" asp-action="Detalle" asp-route-id="@prod.Id" class="text-dark text-decoration-none hover-link">
                                            @prod.Nombre
                                        </a>
                                    </h6>
                                    <p class="text-muted small text-truncate-2 mb-3" style="min-height: 38px;">
                                        @prod.Descripcion
                                    </p>
                                    <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="text-muted small d-block">Precio unitario</span>
                                            <span class="fs-5 fw-bold text-primary">$@prod.Precio.ToString("N2")</span>
                                        </div>
                                        <div class="d-flex gap-1 align-items-center">
                                            <a asp-controller="Catalogo" asp-action="Detalle" asp-route-id="@prod.Id" class="btn btn-outline-secondary btn-sm rounded-circle p-2" title="Ver detalles">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            @if (!User.IsInRole("Administrador") && !User.IsInRole("Vendedor"))
                                            {
                                                <button type="button" class="btn btn-primary btn-sm rounded-circle p-2 shadow-sm" onclick="agregarAlCarrito(@prod.Id, 1)" title="Agregar al carrito" @(prod.Stock <= 0 ? "disabled" : "")>
                                                    <i class="fas fa-cart-plus"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Paginación -->
                @if (Model.TotalPaginas > 1)
                {
                    <nav class="mt-5 d-flex justify-content-center">
                        <ul class="pagination">
                            <li class="page-item @(Model.Pagina <= 1 ? "disabled" : "")">
                                <a class="page-link rounded-pill me-1" href="?Pagina=@(Model.Pagina - 1)&Busqueda=@Model.Busqueda&CategoriaId=@Model.CategoriaId&PrecioMin=@Model.PrecioMin&PrecioMax=@Model.PrecioMax&OrdenarPor=@Model.OrdenarPor">
                                    <i class="fas fa-chevron-left"></i> Anterior
                                </a>
                            </li>
                            @for (int i = 1; i <= Model.TotalPaginas; i++)
                            {
                                <li class="page-item @(Model.Pagina == i ? "active" : "")">
                                    <a class="page-link rounded-circle mx-1" href="?Pagina=@i&Busqueda=@Model.Busqueda&CategoriaId=@Model.CategoriaId&PrecioMin=@Model.PrecioMin&PrecioMax=@Model.PrecioMax&OrdenarPor=@Model.OrdenarPor">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.Pagina >= Model.TotalPaginas ? "disabled" : "")">
                                <a class="page-link rounded-pill ms-1" href="?Pagina=@(Model.Pagina + 1)&Busqueda=@Model.Busqueda&CategoriaId=@Model.CategoriaId&PrecioMin=@Model.PrecioMin&PrecioMax=@Model.PrecioMax&OrdenarPor=@Model.OrdenarPor">
                                    Siguiente <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="card card-lcp border-0 shadow-sm p-5 text-center">
                    <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                    <h4 class="fw-bold text-dark">No se encontraron productos</h4>
                    <p class="text-muted">Intenta ajustando los filtros de búsqueda o categoría.</p>
                    <div class="mt-2">
                        <a asp-controller="Catalogo" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                            Ver todo el catálogo
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            configurarBusquedaSensitiva('catalogo-live-input', 'catalogo-live-results');
        });

        function cambiarOrden(valor) {
            const urlParams = new URLSearchParams(window.location.search);
            urlParams.set('OrdenarPor', valor);
            urlParams.set('Pagina', '1');
            window.location.search = urlParams.toString();
        }
    </script>
}
