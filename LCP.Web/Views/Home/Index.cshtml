@{
    ViewData["Title"] = "Nodo Distribuidor del Centro del País";
    var productosDestacados = ViewBag.ProductosDestacados as List<LCP.Web.Models.Entities.Producto> ?? new();
    var categorias = ViewBag.Categorias as List<LCP.Web.Models.Entities.Categoria> ?? new();
}

<!-- Hero Section Principal LCP -->
<section class="hero-lcp text-white py-5 py-lg-6 mb-5">
    <div class="container px-lg-5 py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <div class="d-inline-flex align-items-center bg-primary bg-opacity-25 border border-primary border-opacity-50 rounded-pill px-3 py-1 mb-3 text-info">
                    <i class="fas fa-shield-alt me-2"></i> Red Logística Integral y Plataforma de Compra-Venta
                </div>
                <h1 class="display-4 fw-extrabold mb-3 lh-sm">
                    El nodo distribuidor de la producción y el comercio en el <span class="text-primary">Centro del País</span>
                </h1>
                <p class="lead text-secondary mb-4">
                    Comprá y vendé directo de productores y distribuidores pampeanos y de la región central. Seguimiento de envíos en tiempo real y confirmación con código QR.
                </p>

                <!-- Barra de búsqueda sensitiva y tracking rápido -->
                <div class="card p-2 border-0 shadow-lg rounded-4 bg-white mb-4 position-relative">
                    <form asp-controller="Catalogo" asp-action="Index" method="get" class="d-flex gap-2">
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-0 text-muted ps-3">
                                <i class="fas fa-search fa-lg"></i>
                            </span>
                            <input type="text" id="input-busqueda-hero" name="busqueda" class="form-control form-control-lg border-0 shadow-none ps-2" placeholder="Buscar productos, herramientas, alimentos pampeanos, repuestos..." autocomplete="off" />
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill px-4 fw-semibold">
                            Buscar
                        </button>
                    </form>
                    <!-- Resultados de búsqueda sensitiva en vivo -->
                    <div id="hero-live-results" class="live-search-results d-none"></div>
                </div>

                <!-- Formulario de Rastrear Envío Rápido -->
                <div class="d-flex flex-wrap align-items-center gap-3 text-secondary small">
                    <span class="text-white"><i class="fas fa-barcode text-warning me-1"></i> ¿Tenés un código de envío?</span>
                    <form asp-controller="Home" asp-action="Seguimiento" method="get" class="d-inline-flex gap-2">
                        <input type="text" name="codigo" class="form-control form-control-sm rounded-pill px-3 bg-dark text-white border-secondary" placeholder="Ej: LCP-20260918-7821" style="width: 210px;" required />
                        <button type="submit" class="btn btn-sm btn-warning rounded-pill px-3 fw-bold">
                            Rastrear
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-lg-5 text-center">
                <div class="position-relative p-4">
                    <img src="~/images/logoCOmpleto-removebg-preview.png" alt="LCP Red Centro" class="img-fluid drop-shadow" style="max-height: 380px; filter: drop-shadow(0 15px 30px rgba(0,0,0,0.5));" onerror="this.src='/images/Logo-removebg-preview.png'" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- KPIs / Estadísticas Rápidas de la Red LCP -->
<section class="container px-lg-5 mb-5" style="margin-top: -50px;">
    <div class="row g-3">
        <div class="col-md-4">
            <div class="card card-lcp p-3 d-flex flex-row align-items-center border-0 shadow-sm">
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle me-3">
                    <i class="fas fa-shipping-fast fa-2x"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0 text-dark">+@ViewBag.TotalEnvios</h3>
                    <p class="text-muted small mb-0">Envíos entregados con éxito</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-lcp p-3 d-flex flex-row align-items-center border-0 shadow-sm">
                <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle me-3">
                    <i class="fas fa-warehouse fa-2x"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0 text-dark">@ViewBag.TotalNodos Nodos</h3>
                    <p class="text-muted small mb-0">Centros logísticos en La Pampa y región</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-lcp p-3 d-flex flex-row align-items-center border-0 shadow-sm">
                <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle me-3">
                    <i class="fas fa-store fa-2x"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0 text-dark">+@ViewBag.TotalVendedores Productores</h3>
                    <p class="text-muted small mb-0">Comercios y distribuidores activos</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Categorías de Productos -->
<section class="container px-lg-5 mb-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h6 class="text-primary text-uppercase fw-bold mb-1"><i class="fas fa-th-large me-2"></i>Rubros y Producción</h6>
            <h2 class="fw-bold mb-0 text-dark">Explorá por Categorías</h2>
        </div>
        <a asp-controller="Catalogo" asp-action="Index" class="btn btn-outline-primary rounded-pill btn-sm px-3">
            Ver todo el catálogo <i class="fas fa-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="row g-3">
        @foreach (var cat in categorias)
        {
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-controller="Catalogo" asp-action="Index" asp-route-categoriaId="@cat.Id" class="card card-lcp text-center p-3 text-decoration-none h-100 border-0 shadow-sm">
                    <div class="text-primary mb-2">
                        <i class="@cat.Icono fa-2x"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-1 small text-truncate">@cat.Nombre</h6>
                    <span class="badge bg-light text-muted small border">@(cat.Productos?.Count ?? 0) publicaciones</span>
                </a>
            </div>
        }
    </div>
</section>

<!-- Publicaciones y Productos Destacados -->
<section class="container px-lg-5 mb-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h6 class="text-primary text-uppercase fw-bold mb-1"><i class="fas fa-star text-warning me-2"></i>Ofertas y Producción Regional</h6>
            <h2 class="fw-bold mb-0 text-dark">Publicaciones Destacadas</h2>
        </div>
        <a asp-controller="Catalogo" asp-action="Index" class="btn btn-outline-primary rounded-pill btn-sm px-3">
            Ver más productos <i class="fas fa-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="row g-4">
        @if (productosDestacados.Any())
        {
            @foreach (var prod in productosDestacados)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="product-card">
                        <div class="product-img-wrapper">
                            <img src="@(prod.ImagenUrl ?? "/images/no-image.png")" alt="@prod.Nombre" loading="lazy" />
                            <span class="badge bg-primary position-absolute top-0 start-0 m-2 rounded-pill px-2 py-1 small">
                                @(prod.Categoria?.Nombre ?? "General")
                            </span>
                        </div>
                        <div class="p-3 d-flex flex-column flex-grow-1">
                            <div class="text-muted small mb-1"><i class="fas fa-store me-1"></i>@(prod.Vendedor?.NombreComercio ?? prod.Vendedor?.NombreCompleto)</div>
                            <h6 class="fw-bold text-dark text-truncate-2 mb-2" style="min-height: 42px;">
                                <a asp-controller="Catalogo" asp-action="Detalle" asp-route-id="@prod.Id" class="text-dark text-decoration-none hover-link">
                                    @prod.Nombre
                                </a>
                            </h6>
                            <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="text-muted small d-block">Precio unitario</span>
                                    <span class="fs-5 fw-bold text-primary">$@prod.Precio.ToString("N2")</span>
                                </div>
                                <button type="button" class="btn btn-primary btn-sm rounded-circle p-2 shadow-sm" onclick="agregarAlCarrito(@prod.Id, 1)" title="Agregar al carrito">
                                    <i class="fas fa-cart-plus fa-lg"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted">No hay productos destacados en este momento.</p>
            </div>
        }
    </div>
</section>

<!-- Sección Beneficios y Logística Pampeana -->
<section class="bg-white py-5 border-top border-bottom">
    <div class="container px-lg-5">
        <div class="row g-4 text-center">
            <div class="col-md-3">
                <div class="p-3">
                    <div class="text-primary mb-3"><i class="fas fa-map-marked-alt fa-3x"></i></div>
                    <h5 class="fw-bold">Ubicación Estratégica</h5>
                    <p class="text-muted small mb-0">Nodo neurálgico en Santa Rosa, conectando el centro con el sur y norte del país.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3">
                    <div class="text-success mb-3"><i class="fas fa-qrcode fa-3x"></i></div>
                    <h5 class="fw-bold">Seguridad con QR</h5>
                    <p class="text-muted small mb-0">Entrega validada exclusivamente con escaneo de código QR al recibir el producto.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3">
                    <div class="text-warning mb-3"><i class="fas fa-comments fa-3x"></i></div>
                    <h5 class="fw-bold">Comunicación Directa</h5>
                    <p class="text-muted small mb-0">Mensajería asíncrona entre compradores y vendedores para resolver dudas al instante.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3">
                    <div class="text-info mb-3"><i class="fas fa-clock fa-3x"></i></div>
                    <h5 class="fw-bold">Trazabilidad Total</h5>
                    <p class="text-muted small mb-0">Seguimiento paso a paso con tiempos estimados y estados detallados de cada paquete.</p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function () {
            configurarBusquedaSensitiva('input-busqueda-hero', 'hero-live-results');
        });
    </script>
}
