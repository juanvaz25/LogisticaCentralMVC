@model LCP.Web.Models.Entities.Pedido
@using LCP.Web.Models.Enums

<div class="tracking-timeline-wrapper my-4">
    <!-- Barra de progreso visual por pasos -->
    <div class="stepper-progress mb-4">
        <div class="step-item @(Model.Estado >= EstadoPedido.EnProceso && Model.Estado != EstadoPedido.Cancelado ? "active" : "") @(Model.Estado > EstadoPedido.EnProceso && Model.Estado != EstadoPedido.Cancelado ? "completed" : "")">
            <div class="step-icon"><i class="fas fa-file-invoice"></i></div>
            <div class="step-label">En Proceso</div>
        </div>
        <div class="step-line @(Model.Estado >= EstadoPedido.EnPreparacion && Model.Estado != EstadoPedido.Cancelado ? "active" : "")"></div>
        <div class="step-item @(Model.Estado >= EstadoPedido.EnPreparacion && Model.Estado != EstadoPedido.Cancelado ? "active" : "") @(Model.Estado > EstadoPedido.EnPreparacion && Model.Estado != EstadoPedido.Cancelado ? "completed" : "")">
            <div class="step-icon"><i class="fas fa-box-open"></i></div>
            <div class="step-label">En Preparación</div>
        </div>
        <div class="step-line @(Model.Estado >= EstadoPedido.EnCamino && Model.Estado != EstadoPedido.Cancelado ? "active" : "")"></div>
        <div class="step-item @(Model.Estado >= EstadoPedido.EnCamino && Model.Estado != EstadoPedido.Cancelado ? "active" : "") @(Model.Estado == EstadoPedido.Entregado ? "completed" : "")">
            <div class="step-icon"><i class="fas fa-truck-moving"></i></div>
            <div class="step-label">En Camino</div>
        </div>
        <div class="step-line @(Model.Estado == EstadoPedido.Entregado ? "active" : "")"></div>
        <div class="step-item @(Model.Estado == EstadoPedido.Entregado ? "active completed" : (Model.Estado == EstadoPedido.Cancelado ? "cancelled" : ""))">
            <div class="step-icon">
                @if (Model.Estado == EstadoPedido.Cancelado)
                {
                    <i class="fas fa-times-circle"></i>
                }
                else
                {
                    <i class="fas fa-check-circle"></i>
                }
            </div>
            <div class="step-label">@(Model.Estado == EstadoPedido.Cancelado ? "Cancelado" : "Entregado")</div>
        </div>
    </div>

    @if (Model.Estado == EstadoPedido.Cancelado && !string.IsNullOrWhiteSpace(Model.MotivoCancelacion))
    {
        <div class="alert alert-danger shadow-sm border-0 d-flex align-items-center mb-4">
            <i class="fas fa-exclamation-triangle fa-2x me-3"></i>
            <div>
                <h6 class="fw-bold mb-1">Motivo de Cancelación Registrado:</h6>
                <p class="mb-0">@Model.MotivoCancelacion</p>
            </div>
        </div>
    }

    <!-- Historial cronológico detallado -->
    <h6 class="fw-bold text-muted text-uppercase mb-3"><i class="fas fa-history me-2 text-primary"></i>Historial de Eventos del Envío</h6>
    <div class="timeline-container">
        @if (Model.Historial != null && Model.Historial.Any())
        {
            @foreach (var h in Model.Historial)
            {
                <div class="timeline-item">
                    <div class="timeline-dot @(h.Estado == EstadoPedido.Entregado ? "bg-success" : (h.Estado == EstadoPedido.Cancelado ? "bg-danger" : "bg-primary"))"></div>
                    <div class="timeline-content card shadow-sm border-0 mb-3">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge @(h.Estado == EstadoPedido.Entregado ? "bg-success" : (h.Estado == EstadoPedido.Cancelado ? "bg-danger" : "bg-primary"))">
                                    @h.Estado
                                </span>
                                <small class="text-muted"><i class="far fa-clock me-1"></i>@h.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm") hs</small>
                            </div>
                            <p class="fw-semibold text-dark mb-1">@h.Descripcion</p>
                            <div class="d-flex justify-content-between text-muted small">
                                <span><i class="fas fa-map-marker-alt me-1 text-danger"></i>@h.Ubicacion</span>
                                @if (!string.IsNullOrEmpty(h.OperadorResponsable))
                                {
                                    <span><i class="fas fa-user-shield me-1"></i>@h.OperadorResponsable</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-muted small">No hay eventos registrados aún.</div>
        }
    </div>
</div>
