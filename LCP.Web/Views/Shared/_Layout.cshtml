    </footer>

    <!-- Core Scripts: jQuery, Bootstrap 5, DataTables, SweetAlert2 -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.6/dist/sweetalert2.all.min.js"></script>

    <!-- Custom Site Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- SweetAlert2 Toast & Alerts Handler -->
    <script>
        $(document).ready(function () {
            // Inicializar DataTables globales con configuración en español
            $('.datatable-lcp').DataTable({
                responsive: true,
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/1.13.8/i18n/es-ES.json'
                },
                pageLength: 10,
                order: []
            });

            @if (TempData["MensajeExito"] != null)
            {
                <text>
                Swal.fire({
                    icon: 'success',
                    title: '¡Operación Exitosa!',
                    text: '@Html.Raw(TempData["MensajeExito"])',
                    confirmButtonColor: '#0d6efd',
                    timer: 4000
                });
                </text>
            }

            @if (TempData["MensajeError"] != null)
            {
                <text>
                Swal.fire({
                    icon: 'error',
                    title: 'Atención',
                    text: '@Html.Raw(TempData["MensajeError"])',
                    confirmButtonColor: '#dc3545'
                });
                </text>
            }

            @if (TempData["MensajeInfo"] != null)
            {
                <text>
                Swal.fire({
                    icon: 'info',
                    title: 'Información',
                    text: '@Html.Raw(TempData["MensajeInfo"])',
                    confirmButtonColor: '#0d6efd',
                    timer: 3500
                });
                </text>
            }
        });

        // Función global para confirmaciones de borrado/desactivación con SweetAlert2
        function confirmarAccionSweet(url, titulo, texto, formId) {
            Swal.fire({
                title: titulo || '¿Está seguro de continuar?',
                text: texto || 'Esta acción no se puede deshacer.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fas fa-trash me-1"></i> Sí, confirmar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    if (formId) {
                        $('#' + formId).submit();
                    } else if (url) {
                        window.location.href = url;
                    }
                }
            });
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
