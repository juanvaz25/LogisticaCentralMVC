            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center small text-secondary">
                <p class="mb-0">&copy; 2026 Logística Centro País (LCP). Todos los derechos reservados. Desarrollado en .NET 10 MVC.</p>
                <div class="mt-2 mt-md-0">
                    <a asp-controller="Home" asp-action="Privacy" class="text-secondary text-decoration-none me-3 hover-link">Privacidad</a>
                    <a asp-controller="Home" asp-action="Contacto" class="text-secondary text-decoration-none hover-link">Términos de Servicio</a>
