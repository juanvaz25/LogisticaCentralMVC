@model LCP.Web.Models.ViewModels.Nodos.NodoViewModel
@{
    ViewData["Title"] = "Crear Nodo Logístico";
}

<div class="container px-lg-5 py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card card-lcp border-0 shadow-sm p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                    <div>
                        <h3 class="fw-bold text-dark mb-1"><i class="fas fa-warehouse text-primary me-2"></i>Nuevo Centro / Nodo LCP</h3>
                        <p class="text-muted small mb-0">Dar de alta una sucursal física o punto de distribución</p>
                    </div>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm">Volver</a>
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <label asp-for="Nombre" class="form-label fw-semibold small text-dark"></label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Nodo Central Santa Rosa - LCP Hub" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="ProvinciaId" class="form-label fw-semibold small text-dark"></label>
                            <select asp-for="ProvinciaId" asp-items="Model.ProvinciasList" class="form-select" required>
                                <option value="">-- Seleccione Provincia --</option>
                            </select>
                            <span asp-validation-for="ProvinciaId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label asp-for="Direccion" class="form-label fw-semibold small text-dark"></label>
                            <input asp-for="Direccion" class="form-control" placeholder="Calle y altura física" />
                            <span asp-validation-for="Direccion" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Ciudad" class="form-label fw-semibold small text-dark"></label>
                            <input asp-for="Ciudad" class="form-control" placeholder="Ciudad o localidad" />
                            <span asp-validation-for="Ciudad" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="CodigoPostal" class="form-label fw-semibold small text-dark"></label>
                            <input asp-for="CodigoPostal" class="form-control" placeholder="CP" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Telefono" class="form-label fw-semibold small text-dark"></label>
                            <input asp-for="Telefono" class="form-control" placeholder="Teléfono de contacto" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="TiempoEstimadoHoras" class="form-label fw-semibold small text-dark"></label>
                            <div class="input-group">
                                <input asp-for="TiempoEstimadoHoras" type="number" class="form-control" />
                                <span class="input-group-text bg-light">hs</span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="TarifaBase" class="form-label fw-semibold small text-dark"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">$</span>
                                <input asp-for="TarifaBase" type="number" step="0.01" class="form-control" />
                            </div>
                            <span asp-validation-for="TarifaBase" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark d-block">Estado del Centro</label>
                            <div class="form-check form-switch p-2 ps-5 bg-light rounded-3 border">
                                <input asp-for="Activo" class="form-check-input" checked />
                                <label asp-for="Activo" class="form-check-label fw-semibold text-dark"></label>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm">
                        <i class="fas fa-save me-1"></i> Guardar Nodo Logístico
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
