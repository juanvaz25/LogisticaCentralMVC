@model LCP.Web.Models.Entities.NodoDistribucion
@{
    ViewData["Title"] = $"Detalle Nodo - {Model.Nombre}";
}

<div class="container px-lg-5 py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card card-lcp border-0 shadow-sm p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                    <div>
                        <h3 class="fw-bold text-dark mb-1">Detalle del Centro Logístico</h3>
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary rounded-pill btn-sm px-3">
                            <i class="fas fa-edit me-1"></i> Editar
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm">Volver</a>
                    </div>
                </div>

                <div class="p-3 bg-light rounded-3 mb-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h4 class="fw-bold text-dark mb-1">@Model.Nombre</h4>
                            <p class="text-muted small mb-0"><i class="fas fa-map-pin text-danger me-1"></i>@Model.Direccion, @Model.Ciudad (@(Model.Provincia?.Nombre))</p>
                        </div>
                        <span class="badge @(Model.Activo ? "bg-success" : "bg-danger") fs-6 px-3 py-1 rounded-pill">
                            @(Model.Activo ? "Activo" : "Inactivo")
                        </span>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="p-3 border rounded-3 text-center">
                            <small class="text-muted d-block text-uppercase fw-bold">Tiempo Estimado</small>
                            <span class="fw-bold text-dark fs-5">@Model.TiempoEstimadoHoras horas</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 border rounded-3 text-center">
                            <small class="text-muted d-block text-uppercase fw-bold">Tarifa Base</small>
                            <span class="fw-bold text-primary fs-5">$@Model.TarifaBase.ToString("N2")</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 border rounded-3 text-center">
                            <small class="text-muted d-block text-uppercase fw-bold">Envíos Gestionados</small>
                            <span class="fw-bold text-success fs-5">@(Model.Pedidos?.Count ?? 0) pedidos</span>
                        </div>
                    </div>
                </div>

                <div class="border-top pt-3 text-muted small">
                    <p class="mb-1"><i class="fas fa-phone-alt me-1"></i><strong>Teléfono:</strong> @(Model.Telefono ?? "N/A")</p>
                    <p class="mb-0"><i class="fas fa-clock me-1"></i><strong>Horario de atención:</strong> @(Model.HorarioAtencion ?? "08:00 a 18:00 hs")</p>
                </div>
            </div>
        </div>
    </div>
</div>
