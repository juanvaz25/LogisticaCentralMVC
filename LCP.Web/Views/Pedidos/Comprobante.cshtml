@model LCP.Web.Models.Entities.Pedido
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Remito y Comprobante LCP - @Model.CodigoSeguimiento</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { font-family: Arial, sans-serif; background-color: #ffffff; color: #333; }
        .invoice-box { max-width: 800px; margin: auto; padding: 30px; border: 1px solid #eee; box-shadow: 0 0 10px rgba(0, 0, 0, 0.15); }
        @@media print {
            .no-print { display: none; }
            .invoice-box { border: none; box-shadow: none; padding: 0; }
        }
    </style>
</head>
<body>
    <div class="container py-4">
        <div class="text-end mb-3 no-print">
            <button onclick="window.print()" class="btn btn-primary rounded-pill px-4">
                <i class="fas fa-print me-1"></i> Imprimir Remito / Comprobante
            </button>
        </div>

        <div class="invoice-box">
            <!-- Header -->
            <div class="row align-items-center border-bottom pb-4 mb-4">
                <div class="col-7">
                    <h3 class="fw-bold mb-1 text-primary">LOGÍSTICA CENTRO PAÍS</h3>
                    <p class="small text-muted mb-0">Red y Distribución Integral del Centro del País - La Pampa</p>
                    <p class="small text-muted mb-0">CUIT: 30-71998877-4 | Santa Rosa, La Pampa</p>
                </div>
                <div class="col-5 text-end">
                    <h5 class="fw-bold mb-1">REMITO DE ENTREGA</h5>
                    <div class="fw-bold text-dark font-monospace fs-5">@Model.CodigoSeguimiento</div>
                    <div class="small text-muted">Fecha: @Model.FechaPedido.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                </div>
            </div>

            <!-- Datos de Entrega y Vendedor -->
            <div class="row g-4 mb-4">
                <div class="col-6">
                    <div class="p-3 bg-light rounded">
                        <h6 class="fw-bold text-primary mb-2">DATOS DEL DESTINATARIO</h6>
                        <div><strong>Comprador:</strong> @Model.Comprador?.NombreCompleto</div>
                        <div><strong>Dirección:</strong> @Model.DireccionEntrega</div>
                        <div><strong>Ciudad / Prov.:</strong> @Model.CiudadEntrega, @Model.ProvinciaEntrega</div>
                        <div><strong>Teléfono:</strong> @Model.TelefonoContacto</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-3 bg-light rounded">
                        <h6 class="fw-bold text-primary mb-2">DATOS DEL REMITENTE / COMERCIO</h6>
                        <div><strong>Vendedor:</strong> @(Model.Vendedor?.NombreComercio ?? Model.Vendedor?.NombreCompleto)</div>
                        <div><strong>CUIT:</strong> @(Model.Vendedor?.Cuit ?? "N/A")</div>
                        <div><strong>Nodo Logístico:</strong> @(Model.NodoDistribucion?.Nombre ?? "Hub Central")</div>
                        <div><strong>Método de Pago:</strong> @Model.MetodoPago</div>
                    </div>
                </div>
            </div>

            <!-- Artículos -->
            <table class="table table-bordered mb-4">
                <thead class="table-light">
                    <tr>
                        <th>Descripción del Artículo</th>
                        <th class="text-center" style="width: 80px;">Cant.</th>
                        <th class="text-end" style="width: 120px;">Unitario</th>
                        <th class="text-end" style="width: 120px;">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Detalles)
                    {
                        <tr>
                            <td>
                                <strong>@(d.Producto?.Nombre)</strong>
                                <div class="small text-muted">SKU: @(d.Producto?.CodigoSku ?? "N/A")</div>
                            </td>
                            <td class="text-center">@d.Cantidad</td>
                            <td class="text-end">$@d.PrecioUnitario.ToString("N2")</td>
                            <td class="text-end fw-bold">$@d.Subtotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end fw-semibold">Subtotal Artículos:</td>
                        <td class="text-end fw-bold">$@Model.Subtotal.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td colspan="3" class="text-end fw-semibold">Costo de Envío Logístico:</td>
                        <td class="text-end fw-bold">$@Model.CostoEnvio.ToString("N2")</td>
                    </tr>
                    <tr class="table-light">
                        <td colspan="3" class="text-end fw-bold fs-5">Total Facturado:</td>
                        <td class="text-end fw-bold fs-5 text-primary">$@Model.Total.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>

            <!-- QR y Firma -->
            <div class="row align-items-center pt-3 border-top">
                <div class="col-4 text-center">
                    @if (!string.IsNullOrEmpty(Model.CodigoQrBase64))
                    {
                        <img src="@Model.CodigoQrBase64" alt="QR" style="width: 110px; height: 110px;" />
                        <div class="small text-muted fw-bold" style="font-size: 0.7rem;">QR Validación LCP</div>
                    }
                </div>
                <div class="col-8">
                    <div class="border-top border-dark pt-2 mt-4 text-center" style="margin-top: 40px !important;">
                        <span class="small text-muted">Firma y Aclaración de Recepción del Destinatario / DNI</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
