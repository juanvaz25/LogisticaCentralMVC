@model List<LCP.Web.Models.Entities.Pedido>
@using LCP.Web.Models.Enums
@{
    ViewData["Title"] = "Mis Pedidos y Envíos";
}

<div class="container-fluid px-lg-5 py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="fw-bold text-dark mb-1"><i class="fas fa-box-open text-primary me-2"></i>Mis Compras y Envíos</h1>
            <p class="text-muted small mb-0">Historial completo de pedidos realizados en la plataforma LCP</p>
        </div>
        <a asp-controller="Catalogo" asp-action="Index" class="btn btn-primary rounded-pill btn-sm px-3">
            <i class="fas fa-store me-1"></i> Ir al Catálogo
        </a>
    </div>

    <div class="card card-lcp border-0 shadow-sm p-4">
        <div class="table-responsive">
            <table class="table table-hover table-lcp align-middle datatable-lcp mb-0">
                <thead>
                    <tr>
                        <th>Código Tracking</th>
                        <th>Fecha</th>
                        <th>Vendedor / Comercio</th>
                        <th>Destino</th>
                        <th>Estado</th>
                        <th>Total</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <a asp-action="Detalle" asp-route-id="@p.Id" class="fw-bold text-primary text-decoration-none font-monospace">
                                    @p.CodigoSeguimiento
                                </a>
                            </td>
                            <td>@p.FechaPedido.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <span class="fw-semibold text-dark">@(p.Vendedor?.NombreComercio ?? p.Vendedor?.NombreCompleto)</span>
                            </td>
                            <td>
                                <small class="text-muted"><i class="fas fa-map-marker-alt text-danger me-1"></i>@p.CiudadEntrega, @p.ProvinciaEntrega</small>
                            </td>
                            <td>
                                <span class="badge @(p.Estado == EstadoPedido.Entregado ? "bg-success" : (p.Estado == EstadoPedido.Cancelado ? "bg-danger" : "bg-primary")) rounded-pill px-3 py-1">
                                    @p.Estado
                                </span>
                            </td>
                            <td class="fw-bold text-dark">$@p.Total.ToString("N2")</td>
                            <td class="text-center">
                                <div class="btn-group">
                                    <a asp-action="Detalle" asp-route-id="@p.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 me-1" title="Ver Seguimiento">
                                        <i class="fas fa-eye me-1"></i> Detalle
                                    </a>
                                    <a asp-action="Comprobante" asp-route-id="@p.Id" target="_blank" class="btn btn-outline-secondary btn-sm rounded-pill px-2" title="Imprimir Comprobante">
                                        <i class="fas fa-print"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
