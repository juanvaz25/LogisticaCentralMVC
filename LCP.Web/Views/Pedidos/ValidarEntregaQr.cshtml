@{
    ViewData["Title"] = "Validación de Entrega QR";
    var pedido = ViewBag.Pedido as LCP.Web.Models.Entities.Pedido;
    bool exito = ViewBag.Exito == true;
    string? mensaje = ViewBag.Mensaje;
    string? error = ViewBag.Error;
}

<div class="container px-lg-5 py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card card-lcp border-0 shadow-sm p-4 p-md-5">
                <div class="mb-3">
                    <img src="~/images/Logo-removebg-preview.png" alt="LCP Logo" height="50" class="mb-2" />
                </div>

                @if (exito)
                {
                    <div class="text-success mb-3">
                        <i class="fas fa-check-circle fa-4x"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-2">¡Entrega Validada!</h3>
                    <p class="text-muted mb-4">@mensaje</p>
                }
                else if (!string.IsNullOrEmpty(error))
                {
                    <div class="text-danger mb-3">
                        <i class="fas fa-times-circle fa-4x"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-2">Error de Validación</h3>
                    <p class="text-muted mb-4">@error</p>
                }
                else
                {
                    <div class="text-info mb-3">
                        <i class="fas fa-info-circle fa-4x"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-2">Estado del Envío</h3>
                    <p class="text-muted mb-4">@mensaje</p>
                }

                @if (pedido != null)
                {
                    <div class="p-3 bg-light rounded-3 text-start mb-4 small">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Tracking:</span>
                            <span class="fw-bold text-primary font-monospace">@pedido.CodigoSeguimiento</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Destinatario:</span>
                            <span class="fw-semibold text-dark">@(pedido.Comprador?.NombreCompleto)</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Destino:</span>
                            <span class="text-dark">@pedido.DireccionEntrega, @pedido.CiudadEntrega</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Estado actual:</span>
                            <span class="badge bg-success">@pedido.Estado</span>
                        </div>
                    </div>
                }

                <div>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                        <i class="fas fa-home me-1"></i> Ir al Inicio
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
