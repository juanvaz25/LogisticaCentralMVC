@model LCP.Web.Models.ViewModels.Productos.ProductoViewModel
@{
    ViewData["Title"] = "Publicar Nuevo Producto";
}

<div class="container px-lg-5 py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card card-lcp border-0 shadow-sm p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                    <div>
                        <h3 class="fw-bold text-dark mb-1"><i class="fas fa-plus-circle text-primary me-2"></i>Publicar Producto</h3>
                        <p class="text-muted small mb-0">Cargá los datos del artículo para sumarlo al catálogo de la red LCP</p>
                    </div>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm">
                        <i class="fas fa-arrow-left me-1"></i> Volver
                    </a>
                </div>

                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold small text-dark"></label>
                        <input asp-for="Nombre" class="form-control" placeholder="Título claro y descriptivo del producto" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CategoriaId" class="form-label fw-semibold small text-dark"></label>
                            <select asp-for="CategoriaId" asp-items="Model.CategoriasList" class="form-select" required>
                                <option value="">-- Seleccionar Categoría --</option>
                            </select>
                            <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CodigoSku" class="form-label fw-semibold small text-dark"></label>
                            <input asp-for="CodigoSku" class="form-control" placeholder="Ej: PROD-LP-001" />
                            <span asp-validation-for="CodigoSku" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Precio" class="form-label fw-semibold small text-dark"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted">$</span>
                                <input asp-for="Precio" type="number" step="0.01" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Precio" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Stock" class="form-label fw-semibold small text-dark"></label>
                            <input asp-for="Stock" type="number" class="form-control" />
                            <span asp-validation-for="Stock" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PesoKg" class="form-label fw-semibold small text-dark"></label>
                            <div class="input-group">
                                <input asp-for="PesoKg" type="number" step="0.1" class="form-control" />
                                <span class="input-group-text bg-light text-muted">kg</span>
                            </div>
                            <span asp-validation-for="PesoKg" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label fw-semibold small text-dark"></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="4" placeholder="Detalles, especificaciones técnicas, origen del producto..."></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ImagenArchivo" class="form-label fw-semibold small text-dark"></label>
                        <input asp-for="ImagenArchivo" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                        <small class="text-muted">Formatos admitidos: JPG, PNG, WEBP (Máx 2MB)</small>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="form-check form-switch p-3 bg-light rounded-3 border">
                                <input asp-for="Activo" class="form-check-input ms-0 me-2" checked />
                                <label asp-for="Activo" class="form-check-label fw-semibold text-dark"></label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch p-3 bg-light rounded-3 border">
                                <input asp-for="Destacado" class="form-check-input ms-0 me-2" />
                                <label asp-for="Destacado" class="form-check-label fw-semibold text-dark"></label>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm">
                        <i class="fas fa-check-circle me-1"></i> Publicar en LCP
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
