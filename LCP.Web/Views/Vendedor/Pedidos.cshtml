@model List<LCP.Web.Models.Entities.Pedido>
@using LCP.Web.Models.Enums
@{
    ViewData["Title"] = "Gestión de Pedidos del Vendedor";
    int? estadoActual = ViewBag.EstadoSeleccionado as int?;
}

<div class="container-fluid px-lg-5 py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h1 class="fw-bold text-dark mb-1"><i class="fas fa-shipping-fast text-primary me-2"></i>Gestión de Pedidos</h1>
            <p class="text-muted small mb-0">Supervisá, empaquetá y despachá los pedidos asignados a tu comercio</p>
        </div>
        <!-- Filtros rápidos por estado -->
        <div class="btn-group mt-2 mt-md-0" role="group">
            <a asp-action="Pedidos" class="btn btn-sm @(estadoActual == null ? "btn-primary" : "btn-outline-secondary")">Todos</a>
            <a asp-action="Pedidos" asp-route-estadoId="1" class="btn btn-sm @(estadoActual == 1 ? "btn-primary" : "btn-outline-secondary")">En Proceso</a>
            <a asp-action="Pedidos" asp-route-estadoId="2" class="btn btn-sm @(estadoActual == 2 ? "btn-primary" : "btn-outline-secondary")">En Preparación</a>
            <a asp-action="Pedidos" asp-route-estadoId="3" class="btn btn-sm @(estadoActual == 3 ? "btn-primary" : "btn-outline-secondary")">En Camino</a>
            <a asp-action="Pedidos" asp-route-estadoId="4" class="btn btn-sm @(estadoActual == 4 ? "btn-primary" : "btn-outline-secondary")">Entregados</a>
            <a asp-action="Pedidos" asp-route-estadoId="5" class="btn btn-sm @(estadoActual == 5 ? "btn-primary" : "btn-outline-secondary")">Cancelados</a>
        </div>
    </div>

    <div class="card card-lcp border-0 shadow-sm p-4">
        <div class="table-responsive">
            <table class="table table-hover table-lcp align-middle datatable-lcp mb-0">
                <thead>
                    <tr>
                        <th>Código Tracking</th>
                        <th>Fecha</th>
                        <th>Comprador</th>
                        <th>Destino</th>
                        <th>Artículos</th>
                        <th>Estado Actual</th>
                        <th>Total</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Pedidos" asp-action="Detalle" asp-route-id="@p.Id" class="fw-bold text-primary font-monospace text-decoration-none">
                                    @p.CodigoSeguimiento
                                </a>
                            </td>
                            <td>@p.FechaPedido.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <span class="fw-semibold text-dark">@(p.Comprador?.NombreCompleto)</span>
                                <div class="small text-muted"><i class="fas fa-phone-alt me-1"></i>@p.TelefonoContacto</div>
                            </td>
                            <td>
                                <small class="text-muted">@p.DireccionEntrega, @p.CiudadEntrega</small>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border">@p.Detalles.Sum(d => d.Cantidad) u.</span>
                            </td>
                            <td>
                                <span class="badge @(p.Estado == EstadoPedido.Entregado ? "bg-success" : (p.Estado == EstadoPedido.Cancelado ? "bg-danger" : (p.Estado == EstadoPedido.EnCamino ? "bg-info text-dark" : "bg-warning text-dark"))) rounded-pill px-3 py-1">
                                    @p.Estado
                                </span>
                            </td>
                            <td class="fw-bold text-dark">$@p.Total.ToString("N2")</td>
                            <td class="text-center">
                                <div class="btn-group">
                                    <a asp-action="CambiarEstado" asp-route-id="@p.Id" class="btn btn-sm btn-primary rounded-pill px-3 me-1" title="Actualizar Estado">
                                        <i class="fas fa-sync-alt me-1"></i> Estado
                                    </a>
                                    <a asp-controller="Pedidos" asp-action="Detalle" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-2" title="Ver Detalle y QR">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
