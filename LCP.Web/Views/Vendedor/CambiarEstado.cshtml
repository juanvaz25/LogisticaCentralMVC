@model LCP.Web.Models.ViewModels.Pedidos.CambiarEstadoPedidoViewModel
@using LCP.Web.Models.Enums
@{
    ViewData["Title"] = $"Actualizar Estado - {Model.CodigoSeguimiento}";
}

<div class="container px-lg-5 py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card card-lcp border-0 shadow-sm p-4 p-md-5">
                <div class="text-center mb-4">
                    <span class="badge bg-primary text-uppercase mb-2">Gestión de Logística LCP</span>
                    <h3 class="fw-bold text-dark mb-1">Actualizar Estado de Pedido</h3>
                    <p class="text-primary font-monospace fw-bold fs-5 mb-0">@Model.CodigoSeguimiento</p>
                </div>

                <form asp-action="CambiarEstado" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="PedidoId" />
                    <input type="hidden" asp-for="CodigoSeguimiento" />

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="NuevoEstado" class="form-label fw-semibold small text-dark"></label>
                        <select asp-for="NuevoEstado" class="form-select form-select-lg" id="select-estado" onchange="verificarEstadoCancelado()">
                            <option value="@EstadoPedido.EnProceso">1. En proceso (Recibido / En gestión)</option>
                            <option value="@EstadoPedido.EnPreparacion">2. En preparación (Aceptado / En empaque)</option>
                            <option value="@EstadoPedido.EnCamino">3. En camino (Despachado en viaje a destino)</option>
                            <option value="@EstadoPedido.Entregado">4. Entregado (Entregado con éxito)</option>
                            <option value="@EstadoPedido.Cancelado">5. Cancelado (Cancelación con motivo)</option>
                        </select>
                        <span asp-validation-for="NuevoEstado" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Ubicacion" class="form-label fw-semibold small text-dark"></label>
                        <input asp-for="Ubicacion" class="form-control" placeholder="Ej: Nodo Central Santa Rosa, En Reparto, etc." />
                    </div>

                    <div class="mb-4 @(Model.NuevoEstado == EstadoPedido.Cancelado ? "" : "d-none")" id="div-motivo-cancelacion">
                        <label asp-for="MotivoObservacion" class="form-label fw-semibold small text-danger">
                            Motivo u Observación de Cancelación <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="MotivoObservacion" class="form-control" rows="3" placeholder="Explique detalladamente el motivo de cancelación para registro del comprador..."></textarea>
                        <span asp-validation-for="MotivoObservacion" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary rounded-pill py-2 fw-bold shadow-sm">
                            <i class="fas fa-save me-1"></i> Guardar y Notificar Estado
                        </button>
                        <a asp-action="Pedidos" class="btn btn-outline-secondary rounded-pill">
                            Volver al Listado
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function verificarEstadoCancelado() {
            const estado = $('#select-estado').val();
            if (estado === '5' || estado === 'Cancelado') {
                $('#div-motivo-cancelacion').removeClass('d-none');
            } else {
                $('#div-motivo-cancelacion').addClass('d-none');
            }
        }
        $(document).ready(function () {
            verificarEstadoCancelado();
        });
    </script>
}
